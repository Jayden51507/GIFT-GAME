/* =============================================
   EVENTS
============================================= */

function addEvent(
  event,
  isGift
) {

  const container =
    document.getElementById(
      "events"
    );

  const div =
    document.createElement(
      "div"
    );

  div.className =
    "event" +
    (isGift
      ? " gift"
      : "");

  if (isGift) {

    div.innerHTML = `
      🎁 <b>
        ${escapeHtml(
          event.nickname
        )}
      </b>

      <small>
        ${escapeHtml(
          event.giftName
        )}
        +${event.value}
        💎
      </small>
    `;

  } else {

    div.innerHTML = `
      ❤️ <b>
        ${escapeHtml(
          event.nickname
        )}
      </b>

      <small>
        joined the CRYPT Army
      </small>
    `;

  }

  container.prepend(
    div
  );

  setTimeout(
    () => div.remove(),
    4000
  );

}

/* =============================================
   DAMAGE NUMBER
============================================= */

function showDamage(
  damage
) {

  const div =
    document.createElement(
      "div"
    );

  div.className =
    "damage";

  div.textContent =
    "-" +
    damage.toLocaleString();

  div.style.left =
    (55 +
      Math.random() * 20) +
    "%";

  div.style.top =
    (35 +
      Math.random() * 25) +
    "%";

  document
    .getElementById(
      "game"
    )
    .appendChild(
      div
    );

  setTimeout(
    () => div.remove(),
    1000
  );

}

/* =============================================
   PARTICLES
============================================= */

function particle(
  x,
  y,
  color
) {

  particles.push({
    x,
    y,
    vx:
      (Math.random() - .5) *
      7,
    vy:
      (Math.random() - .5) *
      7,
    life: 1,
    color,
    size:
      1 +
      Math.random() *
      4
  });

}

function spawnGiftBurst() {

  for (
    let i = 0;
    i < 35;
    i++
  ) {

    particle(
      W * .65,
      H * .45,
      i % 2
        ? "#00ffff"
        : "#b020ff"
    );

  }

  shake =
    Math.min(
      15,
      shake + 7
    );

}

function spawnLikeBurst() {

  for (
    let i = 0;
    i < 4;
    i++
  ) {

    particle(
      W / 2 +
        (Math.random() - .5) *
        300,

      H * .7,

      "#00ffff"
    );

  }

}

/* =============================================
   CRYPT CREATURE
============================================= */

function drawCryptCreature(
  time
) {

  const cx =
    W * .66;

  const cy =
    H * .40;

  const phase =
    state.boss?.phase || 1;

  const pulse =
    Math.sin(
      time * .003
    ) * 5;

  const hit =
    bossPulse * 18;

  ctx.save();

  /*
    Glow
  */

  ctx.shadowBlur =
    35 + hit;

  ctx.shadowColor =
    "#7b18ff";

  /*
    Body
  */

  const bodyGradient =
    ctx.createLinearGradient(
      cx - 100,
      cy - 130,
      cx + 130,
      cy + 150
    );

  bodyGradient.addColorStop(
    0,
    "#07151b"
  );

  bodyGradient.addColorStop(
    .45,
    "#10101d"
  );

  bodyGradient.addColorStop(
    1,
    "#020308"
  );

  ctx.fillStyle =
    bodyGradient;

  ctx.beginPath();

  ctx.moveTo(
    cx - 110,
    cy + 110
  );

  ctx.lineTo(
    cx - 130,
    cy + 10
  );

  ctx.lineTo(
    cx - 100,
    cy - 80
  );

  ctx.lineTo(
    cx - 50,
    cy - 120
  );

  ctx.lineTo(
    cx + 25,
    cy - 130
  );

  ctx.lineTo(
    cx + 100,
    cy - 80
  );

  ctx.lineTo(
    cx + 135,
    cy + 20
  );

  ctx.lineTo(
    cx + 105,
    cy + 120
  );

  ctx.closePath();

  ctx.fill();

  /*
    Wings
  */

  ctx.shadowBlur =
    25;

  ctx.strokeStyle =
    "#8a19ff";

  ctx.lineWidth =
    5;

  ctx.beginPath();

  ctx.moveTo(
    cx - 70,
    cy - 60
  );

  ctx.lineTo(
    cx - 210,
    cy - 145
  );

  ctx.lineTo(
    cx - 160,
    cy - 15
  );

  ctx.lineTo(
    cx - 235,
    cy + 45
  );

  ctx.lineTo(
    cx - 90,
    cy + 20
  );

  ctx.stroke();

  ctx.beginPath();

  ctx.moveTo(
    cx + 65,
    cy - 60
  );

  ctx.lineTo(
    cx + 210,
    cy - 145
  );

  ctx.lineTo(
    cx + 160,
    cy - 15
  );

  ctx.lineTo(
    cx + 235,
    cy + 45
  );

  ctx.lineTo(
    cx + 90,
    cy + 20
  );

  ctx.stroke();

  /*
    Head
  */

  ctx.shadowColor =
    "#00ffff";

  ctx.fillStyle =
    "#050911";

  ctx.beginPath();

  ctx.moveTo(
    cx - 75,
    cy - 95
  );

  ctx.lineTo(
    cx,
    cy - 165
  );

  ctx.lineTo(
    cx + 80,
    cy - 95
  );

  ctx.lineTo(
    cx + 45,
    cy - 10
  );

  ctx.lineTo(
    cx,
    cy + 20
  );

  ctx.lineTo(
    cx - 50,
    cy - 5
  );

  ctx.closePath();

  ctx.fill();

  ctx.strokeStyle =
    "#00ffff";

  ctx.lineWidth =
    3;

  ctx.stroke();

  /*
    Horns
  */

  ctx.strokeStyle =
    "#9b21ff";

  ctx.lineWidth =
    7;

  ctx.beginPath();

  ctx.moveTo(
    cx - 55,
    cy - 110
  );

  ctx.lineTo(
    cx - 110,
    cy - 180
  );

  ctx.moveTo(
    cx + 55,
    cy - 110
  );

  ctx.lineTo(
    cx + 110,
    cy - 180
  );

  ctx.stroke();

  /*
    Eyes
  */

  const eyeGlow =
    18 +
    Math.sin(
      time * .008
    ) * 8;

  ctx.shadowBlur =
    eyeGlow;

  ctx.shadowColor =
    "#00ffff";

  ctx.fillStyle =
    "#bfffff";

  ctx.beginPath();

  ctx.ellipse(
    cx - 27,
    cy - 65,
    13,
    6,
    -.25,
    0,
    Math.PI * 2
  );

  ctx.fill();

  ctx.beginPath();

  ctx.ellipse(
    cx + 27,
    cy - 65,
    13,
    6,
    .25,
    0,
    Math.PI * 2
  );

  ctx.fill();

  /*
    Neon circuitry
  */

  ctx.shadowBlur =
    10;

  ctx.lineWidth =
    2;

  const circuitColors =
    [
      "#00ffff",
      "#9b21ff",
      "#31ff67"
    ];

  for (
    let i = 0;
    i < 12;
    i++
  ) {

    const color =
      circuitColors[
        i %
        circuitColors.length
      ];

    ctx.strokeStyle =
      color;

    ctx.beginPath();

    const offset =
      i * 13;

    ctx.moveTo(
      cx - 80 + offset,
      cy - 20
    );

    ctx.lineTo(
      cx - 40 + offset,
      cy + 15
    );

    ctx.lineTo(
      cx - 10 + offset,
      cy + 60
    );

    ctx.stroke();

  }

  /*
    Claws
  */

  ctx.strokeStyle =
    "#00ffff";

  ctx.lineWidth =
    4;

  for (
    let i = 0;
    i < 3;
    i++
  ) {

    ctx.beginPath();

    ctx.moveTo(
      cx - 70 +
        i * 25,
      cy + 105
    );

    ctx.lineTo(
      cx - 85 +
        i * 25,
      cy + 140
    );

    ctx.stroke();

  }

  /*
    Phase intensity
  */

  if (phase >= 2) {

    ctx.globalAlpha =
      .7;

    ctx.strokeStyle =
      "#00ffff";

    ctx.lineWidth =
      2;

    for (
      let i = 0;
      i < 5;
      i++
    ) {

      ctx.beginPath();

      ctx.arc(
        cx,
        cy,
        150 +
          i * 18 +
          pulse,
        0,
        Math.PI * 2
      );

      ctx.stroke();

    }

  }

  ctx.restore();

  bossPulse *= .88;
}

/* =============================================
   DRAW ATTACKS
============================================= */

function drawAttacks() {

  for (
    let i =
      attacks.length - 1;
    i >= 0;
    i--
  ) {

    const attack =
      attacks[i];

    attack.life -= .035;

    const targetX =
      W * .66;

    const targetY =
      H * .42;

    attack.x =
      attack.x +
      (targetX -
        attack.x) *
        .07;

    attack.y =
      attack.y +
      (targetY -
        attack.y) *
        .07;

    ctx.save();

    ctx.shadowBlur =
      20;

    ctx.shadowColor =
      "#00ffff";

    ctx.strokeStyle =
      "#00ffff";

    ctx.lineWidth =
      4;

    ctx.beginPath();

    ctx.moveTo(
      attack.x - 25,
      attack.y
    );

    ctx.lineTo(
      attack.x + 25,
      attack.y
    );

    ctx.stroke();

    ctx.restore();

    if (
      attack.life <= 0
    ) {

      attacks.splice(
        i,
        1
      );

    }

  }

}

/* =============================================
   PARTICLE DRAW
============================================= */

function drawParticles() {

  for (
    let i =
      particles.length - 1;
    i >= 0;
    i--
  ) {

    const p =
      particles[i];

    p.x += p.vx;
    p.y += p.vy;

    p.vy += .03;

    p.life -= .025;

    ctx.save();

    ctx.globalAlpha =
      Math.max(
        0,
        p.life
      );

    ctx.fillStyle =
      p.color;

    ctx.shadowBlur =
      12;

    ctx.shadowColor =
      p.color;

    ctx.beginPath();

    ctx.arc(
      p.x,
      p.y,
      p.size,
      0,
      Math.PI * 2
    );

    ctx.fill();

    ctx.restore();

    if (
      p.life <= 0
    ) {

      particles.splice(
        i,
        1
      );

    }

  }

}

/* =============================================
   BACKGROUND
============================================= */

function drawBackground(
  time
) {

  ctx.clearRect(
    0,
    0,
    W,
    H
  );

  const gradient =
    ctx.createRadialGradient(
      W * .66,
      H * .42,
      20,
      W * .66,
      H * .42,
      W * .65
    );

  gradient.addColorStop(
    0,
    "rgba(0,255,255,.08)"
  );

  gradient.addColorStop(
    .45,
    "rgba(120,0,255,.07)"
  );

  gradient.addColorStop(
    1,
    "rgba(0,0,0,0)"
  );

  ctx.fillStyle =
    gradient;

  ctx.fillRect(
    0,
    0,
    W,
    H
  );

  /*
    Digital falling particles
  */

  ctx.save();

  ctx.globalAlpha =
    .12;

  ctx.fillStyle =
    "#00ff9d";

  ctx.font =
    "10px monospace";

  for (
    let i = 0;
    i < 90;
    i++
  ) {

    const x =
      (i * 97) %
      W;

    const y =
      (
        time * .02 +
        i * 73
      ) %
      H;

    ctx.fillText(
      Math.random() >
        .5
        ? "1"
        : "0",
      x,
      y
    );

  }

  ctx.restore();

  /*
    Ground
  */

  ctx.save();

  ctx.strokeStyle =
    "rgba(0,255,255,.12)";

  ctx.lineWidth =
    1;

  for (
    let x = 0;
    x < W;
    x += 50
  ) {

    ctx.beginPath();

    ctx.moveTo(
      x,
      H * .82
    );

    ctx.lineTo(
      W / 2 +
        (x - W / 2) *
        .3,
      H
    );

    ctx.stroke();

  }

  ctx.restore();

}

/* =============================================
   MAIN LOOP
============================================= */

function animate(
  time
) {

  ctx.save();

  if (
    shake > 0
  ) {

    ctx.translate(
      (Math.random() - .5) *
        shake,

      (Math.random() - .5) *
        shake
    );

    shake *= .9;

  }

  drawBackground(
    time
  );

  drawCryptCreature(
    time
  );

  drawAttacks();

  drawParticles();

  ctx.restore();

  requestAnimationFrame(
    animate
  );

}

requestAnimationFrame(
  animate
);
