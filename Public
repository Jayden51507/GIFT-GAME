<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta
  name="viewport"
  content="width=device-width,initial-scale=1.0,viewport-fit=cover"
>
<title>CRYPT RAID</title>

<style>
* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #020307;
  color: white;
  font-family: Arial, Helvetica, sans-serif;
  overscroll-behavior: none;
}

button {
  font-family: inherit;
  -webkit-tap-highlight-color: transparent;
}

#game {
  position: relative;
  width: 100vw;
  width: 100dvw;
  height: 100vh;
  height: 100dvh;
  min-height: 480px;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 67% 43%,
      rgba(0,255,255,.13),
      transparent 27%
    ),
    radial-gradient(
      circle at 65% 50%,
      rgba(150,0,255,.14),
      transparent 38%
    ),
    linear-gradient(
      180deg,
      #010207 0%,
      #050712 55%,
      #010207 100%
    );
}

/* =========================
   BACKGROUND
========================= */

#game::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: .16;
  pointer-events: none;

  background:
    repeating-linear-gradient(
      90deg,
      transparent 0,
      transparent 49px,
      rgba(0,255,255,.06) 50px
    ),
    repeating-linear-gradient(
      0deg,
      transparent 0,
      transparent 49px,
      rgba(140,40,255,.04) 50px
    );
}

.scanlines {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 200;

  background:
    repeating-linear-gradient(
      0deg,
      transparent 0px,
      transparent 4px,
      rgba(255,255,255,.012) 5px
    );
}

/* =========================
   HEADER
========================= */

.header {
  position: absolute;
  top: max(10px, env(safe-area-inset-top));
  left: 50%;
  transform: translateX(-50%);
  z-index: 30;

  width: max-content;
  max-width: 70vw;

  text-align: center;
  pointer-events: none;
}

.logo {
  font-size: clamp(19px, 3vw, 28px);
  font-weight: 1000;
  letter-spacing: 4px;

  white-space: nowrap;

  text-shadow:
    0 0 8px #00ffff,
    0 0 18px #8a2cff,
    0 0 35px #00ffff;
}

.subtitle {
  margin-top: 2px;

  font-size: 8px;
  letter-spacing: 3px;

  color: #65ffff;
  opacity: .65;
}

/* =========================
   ROUND
========================= */

#round {
  position: absolute;
  top: max(11px, env(safe-area-inset-top));
  right: 12px;

  z-index: 30;

  padding: 5px 9px;

  border: 1px solid rgba(0,255,255,.25);
  border-radius: 20px;

  background: rgba(0,0,0,.4);

  color: rgba(150,255,255,.7);

  font-size: 8px;
  font-weight: 900;
  letter-spacing: 2px;

  display: none;
}

/* =========================
   BOSS AREA
========================= */

.boss-area {
  position: absolute;

  top: 68px;
  left: 50%;

  width: min(560px, 48vw);

  transform: translateX(-50%);

  z-index: 20;

  text-align: center;
}

.boss-name {
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 3px;

  color: #bfffff;

  text-shadow:
    0 0 7px #00ffff,
    0 0 15px #8a2cff;
}

.hp-shell {
  position: relative;

  width: 100%;
  height: 15px;

  margin-top: 6px;

  padding: 2px;

  border: 1px solid rgba(0,255,255,.65);
  border-radius: 20px;

  background: rgba(0,0,0,.75);

  box-shadow:
    0 0 8px rgba(0,255,255,.25),
    inset 0 0 10px rgba(140,0,255,.18);
}

#hp {
  height: 100%;
  width: 100%;

  border-radius: 20px;

  background:
    linear-gradient(
      90deg,
      #00ffff,
      #287cff,
      #9b21ff,
      #ff19d9
    );

  box-shadow:
    0 0 7px #00ffff,
    0 0 14px #8b20ff;

  transition: width .25s ease;
}

.hp-text {
  margin-top: 3px;

  font-size: 8px;

  color: rgba(255,255,255,.55);
}

/* =========================
   BATTLE CANVAS
========================= */

#battle {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  z-index: 3;

  pointer-events: none;
}

/* =========================
   TOP 5
========================= */

.party {
  position: absolute;

  top: 96px;
  left: 14px;

  width: 150px;

  z-index: 25;
}

.party-title {
  margin-bottom: 5px;

  color: #65ffff;

  font-size: 8px;
  font-weight: 900;
  letter-spacing: 2px;

  text-shadow:
    0 0 8px #00ffff;
}

.hero-card {
  display: flex;
  align-items: center;

  gap: 6px;

  margin-bottom: 4px;

  padding: 4px 6px;

  min-height: 39px;

  border: 1px solid rgba(0,255,255,.18);
  border-radius: 7px;

  background:
    linear-gradient(
      90deg,
      rgba(3,8,18,.82),
      rgba(8,5,25,.55)
    );

  box-shadow:
    0 0 8px rgba(0,255,255,.05);

  overflow: hidden;
}

.hero-card.active {
  border-color: rgba(0,255,255,.5);

  box-shadow:
    0 0 9px rgba(0,255,255,.14),
    inset 0 0 12px rgba(130,0,255,.1);
}

.rank {
  width: 12px;

  flex: 0 0 12px;

  font-size: 8px;
  font-weight: 900;

  color: #a6ffff;
}

.avatar {
  width: 26px;
  height: 26px;

  flex: 0 0 26px;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      #00ffff,
      #7b19ff
    );

  border: 1px solid rgba(255,255,255,.7);

  font-size: 9px;
  font-weight: 900;

  box-shadow:
    0 0 8px rgba(0,255,255,.2);
}

.avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-info {
  min-width: 0;
  flex: 1;
}

.hero-name {
  font-size: 9px;
  font-weight: 900;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-power {
  margin-top: 1px;

  font-size: 7px;

  color: #7affff;
}

/* =========================
   EVENTS
========================= */

#events {
  position: absolute;

  top: 96px;
  right: 14px;

  width: 165px;

  z-index: 25;

  pointer-events: none;
}

.event {
  margin-bottom: 5px;

  padding: 5px 7px;

  border-radius: 6px;

  border: 1px solid rgba(0,255,255,.22);

  background:
    rgba(3,7,17,.65);

  box-shadow:
    0 0 10px rgba(0,255,255,.06);

  animation: eventIn .25s ease-out;

  font-size: 8px;

  opacity: .85;
}

.event.gift {
  border-color:
    rgba(255,0,220,.4);

  box-shadow:
    0 0 10px rgba(255,0,220,.12);
}

.event b {
  color: white;
}

.event small {
  display: block;

  margin-top: 2px;

  color: #7affff;

  font-size: 7px;
}

@keyframes eventIn {
  from {
    transform: translateX(15px);
    opacity: 0;
  }

  to {
    transform: translateX(0);
    opacity: .85;
  }
}

/* =========================
   CROWD
========================= */

.crowd {
  position: absolute;

  left: 50%;
  bottom: 45px;

  transform: translateX(-50%);

  width: min(600px,70vw);
  height: 70px;

  z-index: 12;

  display: flex;
  align-items: flex-end;
  justify-content: center;

  flex-wrap: wrap;

  gap: 2px;

  overflow: hidden;

  padding: 4px;

  mask-image:
    linear-gradient(
      to bottom,
      transparent,
      black 30%
    );
}

.crowd-avatar {
  width: 21px;
  height: 21px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex: 0 0 auto;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      #00ffff,
      #8d21ff
    );

  border: 1px solid rgba(255,255,255,.45);

  font-size: 7px;
  font-weight: 900;

  box-shadow:
    0 0 6px rgba(0,255,255,.22);

  animation:
    crowdIn .3s ease-out;
}

.crowd-avatar img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  border-radius: 50%;
}

@keyframes crowdIn {
  from {
    transform:
      translateY(10px)
      scale(.4);

    opacity: 0;
  }

  to {
    transform:
      translateY(0)
      scale(1);

    opacity: 1;
  }
}

.crowd-label {
  position: absolute;

  bottom: 24px;
  left: 50%;

  transform:
    translateX(-50%);

  z-index: 15;

  font-size: 7px;
  letter-spacing: 3px;

  color:
    rgba(150,255,255,.45);

  pointer-events: none;
}

/* =========================
   DAMAGE
========================= */

.damage {
  position: absolute;

  z-index: 40;

  pointer-events: none;

  font-weight: 1000;

  font-size: 20px;

  color: white;

  text-shadow:
    0 0 7px #00ffff,
    0 0 18px #a020ff;

  animation:
    damageFloat 1s ease-out forwards;
}

@keyframes damageFloat {
  from {
    opacity: 1;

    transform:
      translate(-50%,0)
      scale(.7);
  }

  to {
    opacity: 0;

    transform:
      translate(-50%,-65px)
      scale(1.2);
  }
}

/* =========================
   PHASE
========================= */

#phase {
  position: absolute;

  left: 50%;
  top: 45%;

  transform:
    translate(-50%,-50%);

  z-index: 60;

  pointer-events: none;

  font-size: 20px;
  font-weight: 1000;

  letter-spacing: 4px;

  color: white;

  text-shadow:
    0 0 10px #00ffff,
    0 0 25px #9d20ff;

  opacity: 0;
}

#phase.show {
  animation:
    phaseFlash 1.3s ease-out;
}

@keyframes phaseFlash {
  0% {
    opacity: 0;

    transform:
      translate(-50%,-50%)
      scale(.5);
  }

  25% {
    opacity: 1;

    transform:
      translate(-50%,-50%)
      scale(1.08);
  }

  75% {
    opacity: 1;
  }

  100% {
    opacity: 0;

    transform:
      translate(-50%,-50%)
      scale(1.15);
  }
}

/* =========================
   VICTORY
========================= */

#victory {
  position: absolute;

  inset: 0;

  z-index: 100;

  display: none;

  align-items: center;
  justify-content: center;

  flex-direction: column;

  background:
    radial-gradient(
      circle,
      rgba(0,255,255,.2),
      rgba(80,0,180,.18),
      rgba(0,0,0,.82)
    );

  text-align: center;
}

#victory.show {
  display: flex;

  animation:
    victoryIn .45s ease-out;
}

.victory-title {
  font-size:
    clamp(28px,6vw,46px);

  font-weight: 1000;

  letter-spacing: 4px;

  color: white;

  text-shadow:
    0 0 12px #00ffff,
    0 0 35px #8a1cff,
    0 0 60px #00ffff;
}

.victory-sub {
  margin-top: 7px;

  font-size: 9px;

  letter-spacing: 3px;

  color: #8fffff;
}

@keyframes victoryIn {
  from {
    opacity: 0;
    transform: scale(.75);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* =========================
   TEST TOGGLE
========================= */

#testToggle {
  position: absolute;

  left: max(10px, env(safe-area-inset-left));
  bottom: max(10px, env(safe-area-inset-bottom));

  z-index: 250;

  width: 43px;
  height: 43px;

  border: 1px solid rgba(0,255,255,.4);

  border-radius: 50%;

  background:
    rgba(2,7,15,.92);

  color: white;

  font-size: 17px;

  box-shadow:
    0 0 15px rgba(0,255,255,.15);

  cursor: pointer;

  display: flex;
  align-items: center;
  justify-content: center;

  touch-action: manipulation;

  transition:
    transform .15s ease,
    background .15s ease,
    box-shadow .15s ease;
}

#testToggle:hover {
  background:
    rgba(0,255,255,.15);
}

#testToggle:active {
  transform: scale(.92);
}

#testToggle.open {
  background:
    rgba(0,255,255,.18);

  box-shadow:
    0 0 20px rgba(0,255,255,.3);
}

/* =========================
   TEST PANEL
========================= */

#testPanel {
  position: absolute;

  left: max(10px, env(safe-area-inset-left));
  bottom: calc(
    max(10px, env(safe-area-inset-bottom)) + 52px
  );

  z-index: 240;

  width: 255px;

  max-height: 0;

  overflow: hidden;

  padding: 0;

  opacity: 0;

  pointer-events: none;

  border: 1px solid transparent;

  border-radius: 11px;

  background:
    rgba(1,5,12,.97);

  box-shadow:
    0 0 25px rgba(0,255,255,.12);

  transform: translateY(8px);

  transition:
    max-height .3s ease,
    opacity .2s ease,
    padding .3s ease,
    border-color .3s ease,
    transform .3s ease;
}

#testPanel.open {
  max-height: 310px;

  padding: 9px;

  opacity: 1;

  pointer-events: auto;

  border-color:
    rgba(0,255,255,.3);

  transform: translateY(0);
}

.test-title {
  color: #65ffff;

  font-size: 9px;
  font-weight: 900;

  letter-spacing: 2px;

  margin-bottom: 7px;
}

.test-row {
  display: grid;

  grid-template-columns:
    minmax(0,1fr) 35px 44px 50px;

  gap: 3px;

  align-items: center;

  margin-bottom: 3px;
}

.test-name {
  min-width: 0;

  font-size: 8px;

  overflow: hidden;

  white-space: nowrap;

  text-overflow: ellipsis;
}

.test-row button,
#reset {
  border:
    1px solid rgba(0,255,255,.35);

  border-radius: 5px;

  background:
    rgba(0,255,255,.07);

  color: white;

  font-size: 8px;

  padding: 5px 2px;

  cursor: pointer;

  touch-action: manipulation;
}

.test-row button:active,
#reset:active {
  transform: scale(.96);
}

.test-row button:hover,
#reset:hover {
  background:
    rgba(0,255,255,.2);
}

.gift-button {
  border-color:
    rgba(255,0,220,.45) !important;

  color:
    #ffb4f4 !important;
}

#reset {
  width: 100%;

  margin-top: 5px;
}

/* =========================
   MOBILE
========================= */

@media(max-width:700px) {

  .header {
    top: max(8px, env(safe-area-inset-top));
  }

  .logo {
    font-size: 21px;
    letter-spacing: 3px;
  }

  .subtitle {
    font-size: 7px;
    letter-spacing: 2.5px;
  }

  #round {
    top: max(9px, env(safe-area-inset-top));
    right: 8px;
  }

  .boss-area {
    top: 57px;

    width: 55vw;

    min-width: 185px;
    max-width: 310px;
  }

  .boss-name {
    font-size: 9px;
    letter-spacing: 2.5px;
  }

  .hp-shell {
    height: 13px;
  }

  .party {
    top: 86px;
    left: 7px;

    width: 122px;
  }

  .party-title {
    font-size: 7px;
  }

  .hero-card {
    min-height: 34px;

    padding: 3px 4px;

    gap: 4px;
  }

  .rank {
    width: 10px;
    flex-basis: 10px;
  }

  .avatar {
    width: 23px;
    height: 23px;

    flex-basis: 23px;
  }

  .hero-name {
    font-size: 7px;
  }

  .hero-power {
    font-size: 6px;
  }

  #events {
    top: 86px;
    right: 7px;

    width: 125px;
  }

  .event {
    padding: 4px 5px;

    font-size: 7px;
  }

  .event small {
    font-size: 6px;
  }

  .crowd {
    bottom: 37px;

    width: 70vw;

    height: 55px;
  }

  .crowd-avatar {
    width: 18px;
    height: 18px;
  }

  .crowd-label {
    bottom: 20px;

    font-size: 6px;
  }

  #testToggle {
    width: 39px;
    height: 39px;

    font-size: 15px;
  }

  #testPanel {
    width: min(235px, calc(100vw - 20px));
  }
}

/* =========================
   VERY SMALL PHONES
========================= */

@media(max-width:390px) {

  .logo {
    font-size: 18px;
    letter-spacing: 2px;
  }

  .boss-area {
    width: 52vw;
  }

  .party {
    width: 112px;
  }

  .hero-card {
    min-height: 31px;
  }

  .avatar {
    width: 21px;
    height: 21px;
    flex-basis: 21px;
  }

  .hero-name {
    font-size: 6.5px;
  }

  .hero-power {
    font-size: 5.5px;
  }

  #events {
    width: 112px;
  }
}
</style>
</head>

<body>

<div id="game">

  <div class="scanlines"></div>

  <div class="header">
    <div class="logo">⚡ CRYPT RAID ⚡</div>
    <div class="subtitle">THE CREATURE MUST FALL</div>
  </div>

  <div class="boss-area">
    <div class="boss-name">👹 CRYPT CREATURE</div>

    <div class="hp-shell">
      <div id="hp"></div>
    </div>

    <div class="hp-text">
      <span id="hpText">100,000 / 100,000</span>
    </div>
  </div>

  <canvas id="battle"></canvas>

  <div class="party">
    <div class="party-title">⚔ TOP 5 RAIDERS</div>
    <div id="heroes"></div>
  </div>

  <div id="events"></div>

  <div class="crowd" id="crowd"></div>
  <div class="crowd-label">❤️ THE CRYPT ARMY</div>

  <div id="phase"></div>

  <div id="victory">
    <div class="victory-title">CRYPT DESTROYED</div>
    <div class="victory-sub">
      THE RAIDERS HAVE WON
    </div>
  </div>

  <!-- TEST BUTTON -->
  <button
    id="testToggle"
    type="button"
    aria-label="Open testing panel"
    aria-expanded="false"
  >
    🧪
  </button>

  <!-- TEST PANEL -->
  <div id="testPanel">

    <div class="test-title">
      🧪 MULTI-PLAYER TEST LAB
    </div>

    <div id="testPlayers"></div>

    <button
      id="reset"
      type="button"
    >
      RESET RAID
    </button>

  </div>

</div>

<script src="/socket.io/socket.io.js"></script>

<script>
/* =============================================
   SOCKET
============================================= */

const socket = io();

/* =============================================
   CANVAS
============================================= */

const canvas =
  document.getElementById("battle");

const ctx =
  canvas.getContext("2d");

let W = 800;
let H = 600;

function resize() {

  const rect =
    canvas.getBoundingClientRect();

  const dpr =
    Math.min(
      window.devicePixelRatio || 1,
      2
    );

  W = window.innerWidth;
  H = window.innerHeight;

  canvas.width =
    Math.floor(W * dpr);

  canvas.height =
    Math.floor(H * dpr);

  canvas.style.width =
    W + "px";

  canvas.style.height =
    H + "px";

  ctx.setTransform(
    dpr,
    0,
    0,
    dpr,
    0,
    0
  );
}

window.addEventListener(
  "resize",
  resize
);

window.addEventListener(
  "orientationchange",
  () => {
    setTimeout(resize, 100);
  }
);

resize();

/* =============================================
   STATE
============================================= */

let state = {
  boss: {
    hp: 100000,
    maxHp: 100000,
    phase: 1
  },

  heroes: [],

  likers: []
};

let particles = [];
let attacks = [];

let bossPulse = 0;
let shake = 0;

/* =============================================
   TEST PLAYERS
============================================= */

const TEST_PLAYERS = [
  {
    id: "test_jayden",
    nickname: "Jayden"
  },
  {
    id: "test_sarah",
    nickname: "Sarah"
  },
  {
    id: "test_mike",
    nickname: "Mike"
  },
  {
    id: "test_alex",
    nickname: "Alex"
  },
  {
    id: "test_josh",
    nickname: "Josh"
  },
  {
    id: "test_emma",
    nickname: "Emma"
  },
  {
    id: "test_daniel",
    nickname: "Daniel"
  }
];

/* =============================================
   HELPERS
============================================= */

function escapeHtml(value) {

  return String(value || "")
    .replace(
      /[&<>"']/g,
      char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      }[char])
    );
}

function avatarHTML(
  player,
  className
) {

  if (player.avatarUrl) {

    return `
      <div class="${className}">
        <img
          src="${escapeHtml(
            player.avatarUrl
          )}"
          alt=""
          onerror="this.style.display='none'"
        >
      </div>
    `;
  }

  return `
    <div class="${className}">
      ${escapeHtml(
        (player.nickname || "?")
          .charAt(0)
          .toUpperCase()
      )}
    </div>
  `;
}

/* =============================================
   TEST PANEL
============================================= */

function buildTestPanel() {

  const container =
    document.getElementById(
      "testPlayers"
    );

  if (!container) {
    return;
  }

  container.innerHTML = "";

  TEST_PLAYERS.forEach(
    player => {

      const row =
        document.createElement(
          "div"
        );

      row.className =
        "test-row";

      row.innerHTML = `
        <div class="test-name">
          ${escapeHtml(
            player.nickname
