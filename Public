/* =============================================
   HP
============================================= */

function updateHP() {

  const boss =
    state.boss;

  if (!boss) {
    return;
  }

  const percent =
    Math.max(
      0,
      Math.min(
        100,
        boss.percent ??
        (boss.hp /
          boss.maxHp) *
          100
      )
    );

  document
    .getElementById("hp")
    .style.width =
      percent + "%";

  document
    .getElementById("hpText")
    .textContent =
      `${Math.ceil(
        boss.hp
      ).toLocaleString()} / ${boss.maxHp.toLocaleString()}`;

}

