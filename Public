<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>CRYPT RAID</title>

<style>
* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #020307;
  color: white;
  font-family: Arial, Helvetica, sans-serif;
}

button {
  font-family: inherit;
  -webkit-appearance: none;
}

#game {
  position: relative;
  width: 100vw;
  height: 100dvh;
  min-height: 480px;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 50% 45%,
      rgba(0,255,255,.10),
      transparent 24%
    ),
    radial-gradient(
      circle at 55% 48%,
      rgba(150,0,255,.14),
      transparent 42%
    ),
    linear-gradient(
      180deg,
      #010207 0%,
      #040612 50%,
      #010207 100%
    );
}

/* =========================
   CYBER GRID
========================= */

#game::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .18;

  background:
    repeating-linear-gradient(
      90deg,
      transparent 0,
      transparent 48px,
      rgba(0,255,255,.055) 49px,
      transparent 50px
    ),
    repeating-linear-gradient(
      0deg,
      transparent 0,
      transparent 48px,
      rgba(150,0,255,.045) 49px,
      transparent 50px
    );
}

#game::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 180;

  background:
    radial-gradient(
      ellipse at center,
      transparent 35%,
      rgba(0,0,0,.45) 100%
    );
}

.scanlines {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 200;

  background:
    repeating-linear-gradient(
      0deg,
      transparent 0px,
      transparent 4px,
      rgba(255,255,255,.012) 5px
    );
}

/* =========================
   HEADER
========================= */

.header {
  position: absolute;
  top: max(10px, env(safe-area-inset-top));
  left: 50%;
  transform: translateX(-50%);

  z-index: 30;
  text-align: center;
  pointer-events: none;
  white-space: nowrap;
}

.logo {
  font-size: clamp(20px, 5vw, 30px);
  font-weight: 1000;
  letter-spacing: 4px;

  color: #ffffff;

  text-shadow:
    0 0 6px #00ffff,
    0 0 16px #8a2cff,
    0 0 32px #00ffff;
}

.subtitle {
  margin-top: 2px;

  font-size: 8px;
  letter-spacing: 4px;

  color: #65ffff;
  opacity: .75;

  text-shadow:
    0 0 8px #00ffff;
}

/* =========================
   ROUND
========================= */

#round {
  position: absolute;

  top: max(10px, env(safe-area-inset-top));
  right: 12px;

  z-index: 35;

  padding: 5px 9px;

  border: 1px solid rgba(0,255,255,.35);
  border-radius: 20px;

  background: rgba(0,0,0,.55);

  color: #8fffff;

  font-size: 7px;
  font-weight: 900;
  letter-spacing: 2px;

  box-shadow:
    0 0 12px rgba(0,255,255,.12);
}

/* =========================
   BOSS AREA
========================= */

.boss-area {
  position: absolute;

  top: clamp(62px, 9vh, 82px);
  left: 50%;

  width: min(500px, 58vw);

  transform: translateX(-50%);

  z-index: 25;

  text-align: center;

  pointer-events: none;
}

.boss-name {
  font-size: clamp(9px, 1.5vw, 12px);

  font-weight: 1000;
  letter-spacing: 3px;

  color: #cfffff;

  text-shadow:
    0 0 8px #00ffff,
    0 0 18px #8a2cff;
}

.hp-shell {
  position: relative;

  width: 100%;
  height: 14px;

  margin-top: 7px;
  padding: 2px;

  border: 1px solid rgba(0,255,255,.65);
  border-radius: 20px;

  background: rgba(0,0,0,.8);

  box-shadow:
    0 0 10px rgba(0,255,255,.3),
    0 0 20px rgba(140,0,255,.15),
    inset 0 0 10px rgba(140,0,255,.2);
}

#hp {
  height: 100%;
  width: 100%;

  border-radius: 20px;

  background:
    linear-gradient(
      90deg,
      #00ffff 0%,
      #287cff 35%,
      #9b21ff 70%,
      #ff19d9 100%
    );

  box-shadow:
    0 0 8px #00ffff,
    0 0 18px #8b20ff;

  transition: width .25s ease;
}

.hp-text {
  margin-top: 3px;

  font-size: 8px;
  font-weight: 700;

  color: rgba(255,255,255,.6);
}

/* =========================
   BATTLE CANVAS
========================= */

#battle {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  z-index: 3;

  pointer-events: none;
}

/* =========================
   RAID PARTY
========================= */

.party {
  position: absolute;

  top: clamp(90px, 13vh, 115px);
  left: 12px;

  width: min(155px, 31vw);

  z-index: 25;
}

.party-title {
  margin-bottom: 6px;

  color: #73ffff;

  font-size: 8px;
  font-weight: 1000;
  letter-spacing: 2px;

  text-shadow:
    0 0 8px #00ffff;
}

.hero-card {
  position: relative;

  display: flex;
  align-items: center;

  gap: 6px;

  margin-bottom: 5px;

  min-height: 40px;
  padding: 5px 7px;

  border: 1px solid rgba(0,255,255,.22);
  border-radius: 9px;

  background:
    linear-gradient(
      100deg,
      rgba(3,10,20,.9),
      rgba(15,3,30,.72)
    );

  box-shadow:
    0 0 10px rgba(0,255,255,.05),
    inset 0 0 12px rgba(120,0,255,.08);

  backdrop-filter: blur(6px);

  overflow: hidden;
}

.hero-card::after {
  content: "";

  position: absolute;
  inset: 0;

  pointer-events: none;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(0,255,255,.06),
      transparent
    );

  animation: cardScan 3s linear infinite;
}

@keyframes cardScan {
  from {
    transform: translateX(-100%);
  }

  to {
    transform: translateX(100%);
  }
}

.hero-card.active {
  border-color: rgba(0,255,255,.65);

  box-shadow:
    0 0 12px rgba(0,255,255,.22),
    inset 0 0 15px rgba(120,0,255,.14);
}

.rank {
  width: 13px;

  color: #a6ffff;

  font-size: 8px;
  font-weight: 1000;
}

.avatar {
  width: 27px;
  height: 27px;

  flex: 0 0 27px;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      #00ffff,
      #7b19ff
    );

  border: 1px solid rgba(255,255,255,.8);

  font-size: 9px;
  font-weight: 1000;

  box-shadow:
    0 0 8px rgba(0,255,255,.25);
}

.avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-info {
  min-width: 0;
  flex: 1;
}

.hero-name {
  font-size: 9px;
  font-weight: 1000;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-power {
  margin-top: 2px;

  color: #7affff;

  font-size: 7px;
  font-weight: 700;
}

/* =========================
   LIVE EVENTS
========================= */

#events {
  position: absolute;

  top: clamp(90px, 13vh, 115px);
  right: 12px;

  width: min(165px, 30vw);

  z-index: 25;

  pointer-events: none;
}

.event {
  margin-bottom: 5px;

  padding: 6px 8px;

  border: 1px solid rgba(0,255,255,.25);
  border-radius: 8px;

  background:
    rgba(2,7,17,.72);

  backdrop-filter: blur(7px);

  box-shadow:
    0 0 12px rgba(0,255,255,.08);

  animation: eventIn .3s ease-out;

  font-size: 8px;

  opacity: .9;
}

.event.gift {
  border-color: rgba(255,0,220,.55);

  box-shadow:
    0 0 14px rgba(255,0,220,.16),
    inset 0 0 12px rgba(255,0,220,.06);
}

.event b {
  color: white;
}

.event small {
  display: block;

  margin-top: 2px;

  color: #7affff;

  font-size: 7px;
}

@keyframes eventIn {
  from {
    transform: translateX(18px) scale(.9);
    opacity: 0;
  }

  to {
    transform: translateX(0) scale(1);
    opacity: .9;
  }
}

/* =========================
   CROWD / LIKERS
========================= */

.crowd {
  position: absolute;

  left: 50%;
  bottom: max(34px, env(safe-area-inset-bottom));

  transform: translateX(-50%);

  width: min(500px, 68vw);
  height: 68px;

  z-index: 12;

  display: flex;
  align-items: flex-end;
  justify-content: center;

  flex-wrap: wrap;

  gap: 3px;

  overflow: hidden;

  padding: 5px;

  mask-image:
    linear-gradient(
      to bottom,
      transparent,
      black 28%
    );
}

.crowd-avatar {
  width: 21px;
  height: 21px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      #00ffff,
      #8d21ff
    );

  border: 1px solid rgba(255,255,255,.5);

  font-size: 7px;
  font-weight: 1000;

  box-shadow:
    0 0 7px rgba(0,255,255,.25);

  animation:
    crowdIn .3s ease-out;
}

.crowd-avatar img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  border-radius: 50%;
}

@keyframes crowdIn {
  from {
    transform:
      translateY(12px)
      scale(.35);

    opacity: 0;
  }

  to {
    transform:
      translateY(0)
      scale(1);

    opacity: 1;
  }
}

.crowd-label {
  position: absolute;

  bottom: max(17px, calc(env(safe-area-inset-bottom) + 5px));
  left: 50%;

  transform: translateX(-50%);

  z-index: 15;

  font-size: 7px;
  font-weight: 900;

  letter-spacing: 3px;

  color: rgba(150,255,255,.55);

  text-shadow:
    0 0 8px rgba(0,255,255,.5);

  pointer-events: none;
}

/* =========================
   DAMAGE NUMBERS
========================= */

.damage {
  position: absolute;

  z-index: 60;

  pointer-events: none;

  font-weight: 1000;
  font-size: clamp(20px, 4vw, 30px);

  color: white;

  text-shadow:
    0 0 8px #00ffff,
    0 0 18px #a020ff,
    0 0 30px #ff19d9;

  animation:
    damageFloat 1s ease-out forwards;
}

@keyframes damageFloat {
  from {
    opacity: 1;

    transform:
      translate(-50%,0)
      scale(.7);
  }

  to {
    opacity: 0;

    transform:
      translate(-50%,-70px)
      scale(1.25);
  }
}

/* =========================
   PHASE
========================= */

#phase {
  position: absolute;

  left: 50%;
  top: 47%;

  transform:
    translate(-50%,-50%);

  z-index: 70;

  pointer-events: none;

  font-size: clamp(20px, 5vw, 32px);
  font-weight: 1000;

  letter-spacing: 4px;

  color: white;

  text-shadow:
    0 0 10px #00ffff,
    0 0 25px #9d20ff,
    0 0 45px #ff19d9;

  opacity: 0;
}

#phase.show {
  animation:
    phaseFlash 1.3s ease-out;
}

@keyframes phaseFlash {
  0% {
    opacity: 0;

    transform:
      translate(-50%,-50%)
      scale(.5);
  }

  25% {
    opacity: 1;

    transform:
      translate(-50%,-50%)
      scale(1.1);
  }

  75% {
    opacity: 1;
  }

  100% {
    opacity: 0;

    transform:
      translate(-50%,-50%)
      scale(1.2);
  }
}

/* =========================
   VICTORY
========================= */

#victory {
  position: absolute;

  inset: 0;

  z-index: 100;

  display: none;

  align-items: center;
  justify-content: center;

  flex-direction: column;

  background:
    radial-gradient(
      circle,
      rgba(0,255,255,.22),
      rgba(80,0,180,.2),
      rgba(0,0,0,.88)
    );

  text-align: center;
}

#victory.show {
  display: flex;

  animation:
    victoryIn .45s ease-out;
}

.victory-title {
  font-size:
    clamp(28px, 8vw, 50px);

  font-weight: 1000;

  letter-spacing: 4px;

  color: white;

  text-shadow:
    0 0 12px #00ffff,
    0 0 35px #8a1cff,
    0 0 60px #00ffff;
}

.victory-sub {
  margin-top: 7px;

  font-size: 9px;

  letter-spacing: 3px;

  color: #8fffff;
}

@keyframes victoryIn {
  from {
    opacity: 0;
    transform: scale(.75);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* =========================
   TEST TOGGLE
========================= */

#testToggle {
  position: absolute;

  left: max(10px, env(safe-area-inset-left));
  bottom: max(10px, env(safe-area-inset-bottom));

  z-index: 250;

  width: 45px;
  height: 45px;

  border: 1px solid rgba(0,255,255,.55);
  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(0,255,255,.12),
      rgba(2,7,15,.95)
    );

  color: white;

  font-size: 17px;

  box-shadow:
    0 0 12px rgba(0,255,255,.2),
    inset 0 0 10px rgba(0,255,255,.08);

  cursor: pointer;

  pointer-events: auto;
}

#testToggle:active {
  transform: scale(.92);

  background:
    rgba(0,255,255,.2);

  box-shadow:
    0 0 25px rgba(0,255,255,.5);
}

/* =========================
   TEST PANEL
========================= */

#testPanel {
  position: absolute;

  left: max(10px, env(safe-area-inset-left));
  bottom: max(62px, calc(env(safe-area-inset-bottom) + 52px));

  z-index: 240;

  width: min(270px, calc(100vw - 20px));

  max-height: 0;

  overflow: hidden;

  padding: 0;

  opacity: 0;

  pointer-events: none;

  border: 1px solid transparent;
  border-radius: 12px;

  background:
    linear-gradient(
      180deg,
      rgba(4,10,20,.98),
      rgba(2,4,12,.98)
    );

  box-shadow:
    0 0 25px rgba(0,255,255,.12),
    0 0 50px rgba(130,0,255,.08);

  backdrop-filter: blur(12px);

  transition:
    max-height .3s ease,
    opacity .2s ease,
    padding .3s ease,
    border-color .3s ease;
}

#testPanel.open {
  max-height: 340px;

  padding: 10px;

  opacity: 1;

  pointer-events: auto;

  border-color:
    rgba(0,255,255,.35);
}

.test-title {
  color: #65ffff;

  font-size: 9px;
  font-weight: 1000;

  letter-spacing: 2px;

  margin-bottom: 8px;

  text-shadow:
    0 0 8px #00ffff;
}

.test-row {
  display: grid;

  grid-template-columns:
    minmax(0,1fr)
    36px
    45px
    55px;

  gap: 4px;

  align-items: center;

  margin-bottom: 4px;
}

.test-name {
  min-width: 0;

  overflow: hidden;

  white-space: nowrap;

  text-overflow: ellipsis;

  font-size: 8px;
  font-weight: 700;
}

.test-row button,
#reset {
  border:
    1px solid rgba(0,255,255,.35);

  border-radius: 6px;

  background:
    rgba(0,255,255,.07);

  color: white;

  font-size: 8px;

  padding: 6px 2px;

  cursor: pointer;

  transition:
    transform .12s ease,
    background .12s ease,
    box-shadow .12s ease;
}

.test-row button:active,
#reset:active {
  transform: scale(.94);
}

.test-row button:hover,
#reset:hover {
  background:
    rgba(0,255,255,.18);

  box-shadow:
    0 0 8px rgba(0,255,255,.15);
}

.gift-button {
  border-color:
    rgba(255,0,220,.5) !important;

  color:
    #ffb4f4 !important;
}

#reset {
  width: 100%;

  margin-top: 6px;

  border-color:
    rgba(255,60,120,.35);
}

/* =========================
   MOBILE
========================= */

@media (max-width: 700px) {

  .header {
    top: max(8px, env(safe-area-inset-top));
  }

  .logo {
    font-size: 20px;
    letter-spacing: 3px;
  }

  .subtitle {
    font-size: 7px;
    letter-spacing: 3px;
  }

  #round {
    top: max(8px, env(safe-area-inset-top));
    right: 8px;

    font-size: 6px;
  }

  .boss-area {
    top: 59px;
    width: 58vw;
  }

  .boss-name {
    font-size: 8px;
    letter-spacing: 2px;
  }

  .hp-shell {
    height: 12px;
  }

  .hp-text {
    font-size: 7px;
  }

  .party {
    top: 88px;
    left: 7px;
    width: 126px;
  }

  .party-title {
    font-size: 7px;
    letter-spacing: 1.5px;
  }

  .hero-card {
    min-height: 34px;

    padding: 3px 5px;

    gap: 4px;

    margin-bottom: 4px;
  }

  .rank {
    width: 10px;
    font-size: 7px;
  }

  .avatar {
    width: 23px;
    height: 23px;
    flex-basis: 23px;
  }

  .hero-name {
    font-size: 7px;
  }

  .hero-power {
    font-size: 6px;
  }

  #events {
    top: 88px;
    right: 7px;
    width: 118px;
  }

  .event {
    padding: 4px 5px;
    font-size: 7px;
  }

  .event small {
    font-size: 6px;
  }

  .crowd {
    bottom: max(30px, env(safe-area-inset-bottom));
    width: 72vw;
    height: 52px;
  }

  .crowd-avatar {
    width: 18px;
    height: 18px;
  }

  .crowd-label {
    bottom: max(15px, calc(env(safe-area-inset-bottom) + 1px));
    font-size: 6px;
  }

  #testToggle {
    left: 8px;
    bottom: max(8px, env(safe-area-inset-bottom));

    width: 40px;
    height: 40px;

    font-size: 15px;
  }

  #testPanel {
    left: 8px;

    bottom:
      max(55px, calc(env(safe-area-inset-bottom) + 48px));

    width:
      min(245px, calc(100vw - 16px));
  }
}

/* =========================
   VERY SMALL PHONES
========================= */

@media (max-width: 380px) {

  .logo {
    font-size: 18px;
  }

  .boss-area {
    width: 55vw;
  }

  .party {
    width: 116px;
  }

  .hero-card {
    min-height: 31px;
  }

  .avatar {
    width: 21px;
    height: 21px;
    flex-basis: 21px;
  }

  #events {
    width: 105px;
  }

  .event {
    font-size: 6px;
  }

  .test-row {
    grid-template-columns:
      minmax(0,1fr)
      32px
      40px
      48px;
  }
}
</style>
</head>

<body>

<div id="game">

  <div class="scanlines"></div>

  <div class="header">
    <div class="logo">⚡ CRYPT RAID ⚡</div>
    <div class="subtitle">THE CREATURE MUST FALL</div>
  </div>

  <div class="boss-area">
    <div class="boss-name">👹 CRYPT CREATURE</div>

    <div class="hp-shell">
      <div id="hp"></div>
    </div>

    <div class="hp-text">
      <span id="hpText">100,000 / 100,000</span>
    </div>
  </div>

  <canvas id="battle"></canvas>

  <div class="party">
    <div class="party-title">⚔ TOP 5 RAIDERS</div>
    <div id="heroes"></div>
  </div>

  <div id="events"></div>

  <div class="crowd" id="crowd"></div>
  <div class="crowd-label">❤️ THE CRYPT ARMY</div>

  <div id="phase"></div>

  <div id="victory">
    <div class="victory-title">CRYPT DESTROYED</div>
    <div class="victory-sub">
      THE RAIDERS HAVE WON
    </div>
  </div>

  <!-- =============================================
       TEST PANEL
       ============================================= -->
<button id="testToggle">🧪</button>
  <div id="testPanel">

    <div class="test-title">
      🧪 MULTI-PLAYER TEST LAB
    </div>

    <div id="testPlayers"></div>

    <button id="reset">
      RESET RAID
    </button>

  </div>

</div>

<script src="/socket.io/socket.io.js"></script>

<script>
const socket = io();

const canvas =
  document.getElementById("battle");

const ctx =
  canvas.getContext("2d");

let W = 800;
let H = 600;

let state = {
  boss: {
    hp: 100000,
    maxHp: 100000,
    phase: 1
  },
  heroes: [],
  likers: []
};

let particles = [];
let attacks = [];
let bossPulse = 0;
let shake = 0;

const TEST_PLAYERS = [
  {
    id: "test_jayden",
    nickname: "Jayden"
  },
  {
    id: "test_sarah",
    nickname: "Sarah"
  },
  {
    id: "test_mike",
    nickname: "Mike"
  },
  {
    id: "test_alex",
    nickname: "Alex"
  },
  {
    id: "test_josh",
    nickname: "Josh"
  },
  {
    id: "test_emma",
    nickname: "Emma"
  },
  {
    id: "test_daniel",
    nickname: "Daniel"
  }
];

function resize() {
  W = canvas.width =
    window.innerWidth;

  H = canvas.height =
    window.innerHeight;
}

window.addEventListener(
  "resize",
  resize
);

resize();

/* =============================================
   HELPERS
============================================= */

function escapeHtml(value) {
  return String(value || "")
    .replace(/[&<>"']/g, char => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    }[char]));
}

function avatarHTML(player, className) {
  if (player.avatarUrl) {
    return `
      <div class="${className}">
        <img
          src="${escapeHtml(player.avatarUrl)}"
          onerror="this.style.display='none'"
        >
      </div>
    `;
  }

  return `
    <div class="${className}">
      ${escapeHtml(
        (player.nickname || "?")
          .charAt(0)
          .toUpperCase()
      )}
    </div>
  `;
}

