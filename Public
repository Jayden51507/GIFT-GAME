<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=800, initial-scale=0.45">
<title>Kingdom Territory Overlay</title>
<style>
  html, body {
    margin: 0; padding: 0;
    width: 800px; height: 600px;
    background: transparent;
    overflow: hidden;
    font-family: 'Segoe UI', system-ui, sans-serif;
    color: #fff;
  }
  #stage { position: relative; width: 800px; height: 600px; }

  canvas#map {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(255,244,214,0.12), transparent 60%),
      linear-gradient(180deg, #2b1d3d 0%, #1c1230 55%, #120c22 100%);
    border-radius: 12px;
  }

  #title {
    position: absolute; top: 12px; left: 50%; transform: translateX(-50%);
    font-size: 20px; font-weight: 800; letter-spacing: 1px;
    text-shadow: 0 2px 6px rgba(0,0,0,0.85);
  }

  /* --- Leaderboard --- */
  #leaderboard {
    position: absolute; top: 46px; left: 12px;
    width: 178px;
    background: rgba(20,12,32,0.72);
    border: 2px solid rgba(255,215,120,0.55);
    border-radius: 10px;
    padding: 8px 10px;
    font-size: 12px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.45);
  }
  #leaderboard h3 {
    margin: 2px 0 6px; font-size: 12px; letter-spacing: .5px;
    color: #ffd77a; text-transform: uppercase;
  }
  .lb-row {
    display: flex; align-items: center; gap: 6px;
    padding: 2px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .lb-rank { width: 14px; color: #ffd77a; font-weight: 700; }
  .lb-name { flex: 1; overflow: hidden; text-overflow: ellipsis; }
  .lb-val { color: #ffe3a3; font-weight: 700; }
  .lb-sep { margin: 6px 0; border-top: 1px solid rgba(255,255,255,0.15); }

  /* --- Gift popup --- */
  #popupLayer {
    position: absolute; top: 46px; right: 12px; width: 220px;
    display: flex; flex-direction: column; gap: 8px;
  }
  .gift-card {
    background: linear-gradient(135deg, rgba(255,215,120,0.95), rgba(255,175,70,0.95));
    color: #3a2200;
    border-radius: 12px;
    padding: 8px 10px;
    display: flex; align-items: center; gap: 8px;
    box-shadow: 0 6px 18px rgba(0,0,0,0.4);
    animation: cardIn 0.35s ease-out, cardOut 0.4s ease-in 3.6s forwards;
  }
  .gift-avatar {
    width: 34px; height: 34px; border-radius: 50%;
    background: #5a3b16; color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 14px; flex-shrink: 0;
    border: 2px solid rgba(255,255,255,0.8);
    overflow: hidden;
  }
  .gift-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .gift-text { font-size: 12px; line-height: 1.25; font-weight: 600; }
  .gift-text b { font-size: 13px; }
  @keyframes cardIn {
    from { opacity: 0; transform: translateX(30px) scale(0.9); }
    to   { opacity: 1; transform: translateX(0) scale(1); }
  }
  @keyframes cardOut {
    to { opacity: 0; transform: translateX(30px) scale(0.9); }
  }

  #testBtns {
    position: absolute; bottom: 10px; right: 12px;
    display: flex; gap: 6px;
  }
  #testBtns button {
    padding: 6px 10px; font-size: 11px;
    background: rgba(255,255,255,0.15); color: #fff;
    border: 1px solid rgba(255,255,255,0.4); border-radius: 8px;
  }
</style>
</head>
<body>
  <div id="stage">
    <canvas id="map" width="800" height="600"></canvas>
    <div id="title">🏰 KINGDOM TERRITORIES</div>

    <div id="leaderboard">
      <h3>👑 Top Gifters</h3>
      <div id="lbGifters"></div>
      <div class="lb-sep"></div>
      <h3>❤️ Top Likers</h3>
      <div id="lbLikers"></div>
    </div>

    <div id="popupLayer"></div>

    <div id="testBtns">
      <button id="testLike">Test Like</button>
      <button id="testGift">Test Gift</button>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    const canvas = document.getElementById('map');
    const ctx = canvas.getContext('2d');

    // Latest server snapshot; we interpolate toward it each frame for smoothness.
    let targetBlobs = [];      // from server: {uniqueId, nickname, avatarUrl, color, x, y, radius, recentlyGifted}
    let renderBlobs = new Map(); // uniqueId -> {x,y,radius,...} current animated values
    const avatarImgCache = new Map(); // uniqueId -> HTMLImageElement (or null if failed)

    function getAvatarImg(uniqueId, url) {
      if (!url) return null;
      if (avatarImgCache.has(uniqueId)) return avatarImgCache.get(uniqueId);
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.src = url;
      let ok = true;
      img.onerror = () => { ok = false; };
      avatarImgCache.set(uniqueId, img);
      return img;
    }

    function lerp(a, b, t) { return a + (b - a) * t; }

    socket.on('map', (snapshot) => { targetBlobs = snapshot; });

    function drawBackgroundTexture() {
      // Soft parchment/kingdom-map grid dots
      ctx.save();
      ctx.globalAlpha = 0.08;
      ctx.fillStyle = '#ffffff';
      for (let x = 20; x < 800; x += 40) {
        for (let y = 20; y < 600; y += 40) {
          ctx.beginPath();
          ctx.arc(x, y, 1.2, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.restore();
    }

    function drawBlob(b) {
      const { x, y, radius, color, nickname, recentlyGifted, avatarUrl, uniqueId } = b;

      // Glow ring if recently gifted
      if (recentlyGifted) {
        ctx.save();
        ctx.shadowColor = '#ffd77a';
        ctx.shadowBlur = 26;
        ctx.beginPath();
        ctx.arc(x, y, radius + 4, 0, Math.PI * 2);
        ctx.strokeStyle = '#ffd77a';
        ctx.lineWidth = 3;
        ctx.stroke();
        ctx.restore();
      }

      // Territory circle
      ctx.save();
      ctx.beginPath();
      ctx.arc(x, y, radius, 0, Math.PI * 2);
      const grad = ctx.createRadialGradient(x - radius * 0.3, y - radius * 0.3, radius * 0.1, x, y, radius);
      grad.addColorStop(0, shade(color, 30));
      grad.addColorStop(1, color);
      ctx.fillStyle = grad;
      ctx.fill();
      ctx.lineWidth = 3;
      ctx.strokeStyle = 'rgba(255,255,255,0.55)';
      ctx.stroke();
      ctx.restore();

      // Avatar (clipped circle) or initials
      const avSize = Math.min(radius * 1.1, 46);
      ctx.save();
      ctx.beginPath();
      ctx.arc(x, y, avSize / 2, 0, Math.PI * 2);
      ctx.closePath();
      ctx.clip();
      const img = getAvatarImg(uniqueId, avatarUrl);
      if (img && img.complete && img.naturalWidth > 0) {
        ctx.drawImage(img, x - avSize / 2, y - avSize / 2, avSize, avSize);
      } else {
        ctx.fillStyle = 'rgba(0,0,0,0.35)';
        ctx.fill();
        ctx.fillStyle = '#fff';
        ctx.font = `bold ${Math.max(12, avSize * 0.42)}px sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText((nickname || '?').slice(0, 1).toUpperCase(), x, y);
      }
      ctx.restore();

      // Nickname label
      ctx.save();
      ctx.font = 'bold 12px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillStyle = 'rgba(0,0,0,0.6)';
      ctx.fillText(nickname, x + 1, y + radius + 15);
      ctx.fillStyle = '#fff';
      ctx.fillText(nickname, x, y + radius + 14);
      ctx.restore();
    }

    function shade(hex, percent) {
      const num = parseInt(hex.slice(1), 16);
      let r = (num >> 16) + percent;
      let g = ((num >> 8) & 0x00ff) + percent;
      let b = (num & 0x0000ff) + percent;
      r = Math.min(255, Math.max(0, r));
      g = Math.min(255, Math.max(0, g));
      b = Math.min(255, Math.max(0, b));
      return `rgb(${r},${g},${b})`;
    }

    function tick() {
      // Merge/interpolate render state toward target
      const targetIds = new Set(targetBlobs.map(b => b.uniqueId));
      for (const id of [...renderBlobs.keys()]) {
        if (!targetIds.has(id)) {
          // shrink out anything no longer in the snapshot (fully despawned)
          const r = renderBlobs.get(id);
          r.radius = lerp(r.radius, 0, 0.25);
          if (r.radius < 1) renderBlobs.delete(id);
        }
      }
      for (const t of targetBlobs) {
        const cur = renderBlobs.get(t.uniqueId) || { ...t };
        cur.x = lerp(cur.x, t.x, 0.15);
        cur.y = lerp(cur.y, t.y, 0.15);
        cur.radius = lerp(cur.radius, t.radius, 0.18);
        cur.color = t.color;
        cur.nickname = t.nickname;
        cur.avatarUrl = t.avatarUrl;
        cur.recentlyGifted = t.recentlyGifted;
        cur.uniqueId = t.uniqueId;
        renderBlobs.set(t.uniqueId, cur);
      }

      ctx.clearRect(0, 0, 800, 600);
      drawBackgroundTexture();
      // biggest in back, smallest in front looks nicer for overlaps
      const sorted = [...renderBlobs.values()].sort((a, b) => b.radius - a.radius);
      for (const b of sorted) drawBlob(b);

      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);

    // --- Leaderboard ---
    function renderLeaderboard(list, targetEl, valueKey, suffix) {
      targetEl.innerHTML = '';
      if (!list.length) {
        targetEl.innerHTML = '<div class="lb-row" style="opacity:.6">— none yet —</div>';
        return;
      }
      list.forEach((entry, i) => {
        const row = document.createElement('div');
        row.className = 'lb-row';
        row.innerHTML = `<span class="lb-rank">${i + 1}.</span><span class="lb-name">${escapeHtml(entry.nickname)}</span><span class="lb-val">${entry[valueKey]}${suffix}</span>`;
        targetEl.appendChild(row);
      });
    }
    function escapeHtml(s) {
      return (s || '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    socket.on('leaderboard', ({ topGifters, topLikers }) => {
      renderLeaderboard(topGifters, document.getElementById('lbGifters'), 'diamonds', '💎');
      renderLeaderboard(topLikers, document.getElementById('lbLikers'), 'likes', '❤️');
    });

    // --- Gift popup cards ---
    socket.on('gift-popup', (evt) => {
      const layer = document.getElementById('popupLayer');
      const card = document.createElement('div');
      card.className = 'gift-card';
      const avatarInner = evt.avatarUrl
        ? `<img src="${evt.avatarUrl}" onerror="this.parentElement.textContent='${(evt.nickname || '?').slice(0,1).toUpperCase()}'">`
        : (evt.nickname || '?').slice(0, 1).toUpperCase();
      const countTxt = evt.repeatCount > 1 ? ` x${evt.repeatCount}` : '';
      card.innerHTML = `
        <div class="gift-avatar">${avatarInner}</div>
        <div class="gift-text"><b>${escapeHtml(evt.nickname)}</b><br>sent ${escapeHtml(evt.giftName)}${countTxt} 💎${evt.value}</div>
      `;
      layer.appendChild(card);
      setTimeout(() => card.remove(), 4200);
    });

    // --- Manual test buttons ---
    document.getElementById('testLike').addEventListener('click', () => socket.emit('manual-test-like'));
    document.getElementById('testGift').addEventListener('click', () => socket.emit('manual-test-gift'));
  </script>
</body>
</html>
