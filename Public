/* =============================================
   HEROES
============================================= */

function renderHeroes() {

  const container =
    document.getElementById(
      "heroes"
    );

  if (!container) {
    return;
  }

  container.innerHTML = "";

  const heroes =
    Array.isArray(state.heroes)
      ? state.heroes
      : [];

  for (
    let i = 0;
    i < 5;
    i++
  ) {

    const hero =
      heroes[i];

    if (!hero) {

      container.innerHTML += `
        <div class="hero-card">

          <div class="rank">
            ${i + 1}
          </div>

          <div class="avatar">
            ?
          </div>

          <div class="hero-info">

            <div class="hero-name">
              OPEN SLOT
            </div>

            <div class="hero-power">
              Gift to enter
            </div>

          </div>

        </div>
      `;

      continue;
    }

    const diamonds =
      Number(
        hero.diamonds || 0
      );

    container.innerHTML += `
      <div class="hero-card active">

        <div class="rank">
          ${hero.rank || i + 1}
        </div>

        ${avatarHTML(
          hero,
          "avatar"
        )}

        <div class="hero-info">

          <div class="hero-name">
            ${escapeHtml(
              hero.nickname
            )}
          </div>

          <div class="hero-power">
            ⚡ ${diamonds.toLocaleString()}
          </div>

        </div>

      </div>
    `;
  }
}

/* =============================================
   CROWD
============================================= */

function renderCrowd() {

  const container =
    document.getElementById(
      "crowd"
    );

  if (!container) {
    return;
  }

  const likers =
    Array.isArray(state.likers)
      ? state.likers
      : [];

  container.innerHTML = "";

  likers
    .slice(0, 80)
    .forEach(
      liker => {

        container.innerHTML +=
          avatarHTML(
            liker,
            "crowd-avatar"
          );

      }
    );
}

/* =============================================
   HP
============================================= */

function updateHP() {

  const boss =
    state.boss;

  if (!boss) {
    return;
  }

  const hp =
    Number(
      boss.hp || 0
    );

  const maxHp =
    Number(
      boss.maxHp || 100000
    );

  const percent =
    Math.max(
      0,
      Math.min(
        100,
        boss.percent ??
        (hp / maxHp) * 100
      )
    );

  document
    .getElementById("hp")
    .style.width =
      percent + "%";

  document
    .getElementById("hpText")
    .textContent =
      `${Math.ceil(hp).toLocaleString()} / ${maxHp.toLocaleString()}`;
}

